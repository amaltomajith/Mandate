{
  "name": "mandate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx scripts/seed.ts",
    "worker": "tsx --tsconfig worker/tsconfig.json worker/src/index.ts",
