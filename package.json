    "@noble/hashes": "^2.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@supabase/supabase-js": "^2.112.4",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "next": "16.3.2",
    "ogl": "^1.0.11",
    "openai": "^7.5.0",
    "pino": "^10.4.0",
    "postprocessing": "^6.39.5",
    "qrcode": "^1.5.4",
