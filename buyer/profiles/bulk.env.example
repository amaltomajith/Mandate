# ── bulk ──────────────────────────────────────────────────────────────────
# Buys for a team, so its orders routinely cross the merchant's step-up
# threshold. This is the profile that makes the ESCALATION QUEUE populate
# naturally: nothing here is staged, the amounts simply land above the line
# and the policy engine asks a human.
#
# Its trust score is expected to sit BELOW the ergonomic buyer's even though
# it does nothing wrong - escalations are weighted separately from clean
# allows, which is the behaviour the trust model is meant to show.
#
#   npm --prefix buyer run keygen -- --profile bulk
#   npm --prefix buyer start -- --profile bulk

MANDATE_MCP_URL=http://localhost:3000/api/m/<merchant-slug>/mcp
BUYER_AGENT_ID=
BUYER_PRIVATE_KEY=

BUYER_PERSONA=You are equipping a whole team, not one desk. You buy the better tier of everything because it will be used by several people and has to last, and you are comfortable placing large orders - a single purchase of eight to fifteen thousand rupees is routine for you. You accept a suggested complement when it makes sense at that scale.
BUYER_BUDGET_PAISE=6000000

BUYER_GAP_MS=30000
BUYER_MAX_ACTIONS=20

GROQ_API_KEY=
