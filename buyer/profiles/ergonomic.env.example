# ── ergonomic ─────────────────────────────────────────────────────────────
# Deliberate buyer with real money to spend. Buys one good thing rather than
# three cheap ones, and takes a complement when it genuinely completes the
# setup. Expected to accumulate a HIGH trust score: steady, in-policy, few
# refusals.
#
#   npm --prefix buyer run keygen -- --profile ergonomic
#   npm --prefix buyer start -- --profile ergonomic

MANDATE_MCP_URL=http://localhost:3000/api/m/<merchant-slug>/mcp
BUYER_AGENT_ID=
BUYER_PRIVATE_KEY=

BUYER_PERSONA=You are outfitting a home office you will use every day for years. You care about ergonomics, posture and cable clutter. You would rather buy one well-made thing than three cheap ones, and you will accept a suggested accessory when it genuinely completes what you just bought - a stand for a monitor, a mat for a keyboard - but not an unrelated upsell.
BUYER_BUDGET_PAISE=1500000

BUYER_GAP_MS=25000
BUYER_MAX_ACTIONS=20

GROQ_API_KEY=
