# Exactly three things. If this file ever grows a database or Razorpay
# credential, the isolation this agent demonstrates has been broken.

# The merchant's public MCP endpoint. Discovered from their catalog, or given.
MANDATE_MCP_URL=http://localhost:3000/api/m/demo/mcp

# This agent's Ed25519 private key, base64. Generate with:
#   npm --prefix buyer run keygen
# The matching public key is registered with the merchant; the keyid you sign
# with IS your agent id.
BUYER_PRIVATE_KEY=
BUYER_AGENT_ID=

# Judgement runs on a hosted model. The buyer holds no policy configuration, so
# nothing here touches the merchant's internal egress class.
GROQ_API_KEY=
